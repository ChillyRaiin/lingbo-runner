{
  "name": "lingbo-runner",
  "version": "0.3.1",
  "private": true,
  "description": "循跑：以丹尼尔斯训练原则为基础的微信小程序框架",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "start": "node server/index.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "node --watch server/index.mjs",
    "test:python": "node scripts/python-tools.mjs test",
    "package": "node scripts/python-tools.mjs package",
    "backup": "node scripts/python-tools.mjs backup",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-project.mjs"
  }
}
