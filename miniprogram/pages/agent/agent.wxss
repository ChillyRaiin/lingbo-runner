.chat-scroll { max-height: 820rpx; }
.chat-message { padding: 24rpx; margin-bottom: 20rpx; border-radius: 20rpx; border: 1rpx solid #e1e7df; background: white; }
.chat-user { background: #e7f1ea; margin-left: 48rpx; }
.chat-content { display: block; white-space: pre-wrap; font-size: 27rpx; line-height: 1.9; margin: 12rpx 0; overflow-wrap: anywhere; }
.chat-citation { border-left: 4rpx solid #c2dacb; margin: 18rpx 0; padding: 8rpx 18rpx; font-size: 24rpx; }
.chat-input { width: 100%; min-height: 100rpx; box-sizing: border-box; font-size: 28rpx; line-height: 1.7; padding: 16rpx; background: #f4f7f3; border-radius: 12rpx; }
