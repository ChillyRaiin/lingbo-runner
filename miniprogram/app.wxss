page { background: #f5f7f4; color: #1e302a; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 28rpx; }
.page { padding: 32rpx 32rpx 64rpx; }
.eyebrow { color: #176b53; font-size: 22rpx; letter-spacing: 4rpx; margin-bottom: 12rpx; }
.title { font-size: 48rpx; font-weight: 700; line-height: 1.35; }
.subtitle { color: #74817b; font-size: 26rpx; line-height: 1.7; margin: 12rpx 0 28rpx; }
.card { background: #fff; border: 1rpx solid #e4eae5; border-radius: 24rpx; padding: 30rpx; margin-bottom: 22rpx; }
.hero { background: #176b53; color: #fff; border: 0; }
.hero .muted { color: #c7e1d6; }
.card-title { font-size: 32rpx; font-weight: 600; margin-bottom: 18rpx; }
.muted { color: #74817b; font-size: 24rpx; line-height: 1.7; }
.large { font-size: 68rpx; font-weight: 700; line-height: 1.3; font-variant-numeric: tabular-nums; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.metric { flex: 1; min-width: 160rpx; }
.label { font-size: 24rpx; color: #74817b; margin-bottom: 8rpx; }
.value { font-size: 42rpx; font-weight: 600; }
.badge { display: inline-block; background: #e9f3ed; color: #176b53; padding: 8rpx 16rpx; border-radius: 12rpx; font-size: 22rpx; }
.note { background: #f4ead9; color: #866225; border-radius: 16rpx; padding: 18rpx 22rpx; margin: 18rpx 0; font-size: 24rpx; line-height: 1.65; }
.danger { background: #fcebe6; color: #9f4936; }
.line { padding: 18rpx 0; border-bottom: 1rpx solid #edf0ec; line-height: 1.65; }
.line:last-child { border: 0; }
.bullet { margin-bottom: 12rpx; font-size: 26rpx; line-height: 1.7; }
.input { box-sizing: border-box; width: 100%; background: #f5f7f4; border: 1rpx solid #e4eae5; border-radius: 14rpx; padding: 0 22rpx; height: 86rpx; margin: 10rpx 0 22rpx; font-size: 28rpx; }
.picker { box-sizing: border-box; background: #f5f7f4; border: 1rpx solid #e4eae5; border-radius: 14rpx; padding: 22rpx; margin: 10rpx 0 22rpx; }
button { font-size: 28rpx; border-radius: 16rpx; margin-top: 18rpx; }
button::after { border: 0; }
.primary { background: #176b53; color: #fff; }
.secondary { background: #edf3ee; color: #176b53; }
.destructive { background: #fcebe6; color: #9f4936; }
.link { color: #176b53; font-size: 26rpx; padding: 12rpx 0; }
.bar-chart { height: 160rpx; display: flex; align-items: flex-end; gap: 16rpx; padding-top: 16rpx; }
.bar-item { flex: 1; text-align: center; }
.bar { background: #a4c9b8; border-radius: 8rpx 8rpx 0 0; min-height: 4rpx; }
.bar-label { margin-top: 12rpx; font-size: 20rpx; color: #74817b; }
.empty { color: #74817b; padding: 28rpx 0; line-height: 1.8; }
.timeline { border-left: 3rpx solid #c3dbce; padding-left: 26rpx; }
.split { margin: 20rpx 0; height: 1rpx; background: #e4eae5; }
