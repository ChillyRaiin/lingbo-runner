# 本地联调用 demo；公开部署必须改成 wechat。
AUTH_MODE=demo
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/runner.sqlite
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 用 32 字节随机密钥的 base64 值；真实模式必填，只在服务端保存。
SESSION_ENCRYPTION_KEY=

# DeepSeek V4.1 Flash 的官方 API 标识为 deepseek-flash。
# 密钥只填服务器 .env；未配置时 Agent 使用本地检索，不发送模型请求。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
KNOWLEDGE_DIRECTORY=./.private/knowledge
# 此开关控制 .private 的旧单书索引；同项目书库使用 PRIVATE_LIBRARY_ACCESS 控制真实部署范围。
KNOWLEDGE_PRIVATE_ENABLED=true
PROJECT_KNOWLEDGE_DIRECTORY=../knowledge-base
# 真实微信模式接入本地私有书库前，须按实际私有部署和内容许可确认后显式启用。
PRIVATE_LIBRARY_ACCESS=false
# iPhone 伴随端需要可访问的 HTTPS 后端；127.0.0.1 仅用于电脑本地预览。
PUBLIC_BASE_URL=
